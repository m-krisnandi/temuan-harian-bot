[Unit]
Description=Temuan Harian Web Catalog & Admin
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/temuan-harian-bot
EnvironmentFile=/var/www/temuan-harian-bot/.env
ExecStart=/var/www/temuan-harian-bot/venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
