# Shopee Affiliate Open API (dashboard affiliate.shopee.co.id -> Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.co.id/graphql

# Shopee Affiliate ID numerik (lihat di Dashboard -> Profil / Pengaturan Akun)
# Digunakan untuk auto-generate link tracking universal (an_redir) tanpa butuh Open API
SHOPEE_AFFILIATE_ID=

# TikTok Shop Creator / Affiliate ID atau Username Etalase (opsional)
TIKTOK_AFFILIATE_ID=

# Google Gemini AI Caption Engine (Edukasi, Faktual, Halal, Bebas Hoaks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta Facebook Graph API (v27.0)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v27.0

# Meta Threads API
THREADS_APP_ID=1859560825052480
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram Graph API (Akun Profesional/Bisnis yang tertaut)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Meta Marketing API (Iklan Berbayar Masa Depan)
META_AD_ACCOUNT_ID=

# Multi-Posting Channels Toggle (1 = aktif, 0 = nonaktif)
CHANNEL_FB_ENABLED=1
CHANNEL_THREADS_ENABLED=1
CHANNEL_IG_ENABLED=0

# Jadwal & Frekuensi Posting (Rekomendasi Indonesia: 2-3x per hari)
POST_FREQUENCY_PER_DAY=3
POST_SCHEDULE_TIMES="08:00, 12:30, 19:30"

# Password akses dashboard admin (temuan-harian.pdfumi.com/admin)
ADMIN_SECRET=

# Kata kunci pencarian produk viral otomatis (opsional, pisahkan dengan koma)
AUTO_SCOUT_KEYWORDS="barang unik rumah tangga, alat dapur unik viral, gadget unik murah"

# Lokasi database SQLite (opsional, default: temuan_harian.db di direktori skrip)
TEMUAN_DB=
